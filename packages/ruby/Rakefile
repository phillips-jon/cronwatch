# frozen_string_literal: true

require "rake/testtask"

# The ActiveRecord store and the Rails integration load ActiveRecord and boot
# a Rails app, so each runs in a process of its own, away from the core tests.
INTEGRATIONS = %w[active_record rails].freeze

Rake::TestTask.new("test:core") do |t|
  t.libs << "lib" << "test"
  t.test_files = FileList["test/**/*_test.rb"].exclude(*INTEGRATIONS.map { |dir| "test/#{dir}/**/*" })
  t.warning = true
end

INTEGRATIONS.each do |dir|
  Rake::TestTask.new("test:#{dir}") do |t|
    t.libs << "lib" << "test"
    t.test_files = FileList["test/#{dir}/**/*_test.rb"]
    t.warning = false # Rails' own warnings would drown the output
  end
end

desc "Run every test: core, then the ActiveRecord store (Postgres when CRONWATCH_TEST_PG is set), then Rails"
task test: ["test:core", *INTEGRATIONS.map { |dir| "test:#{dir}" }]

task default: :test
